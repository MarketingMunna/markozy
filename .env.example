# Copy this file to .env.local and fill in real values.

# Public site URL (used for metadata, sitemap and Open Graph links)
NEXT_PUBLIC_SITE_URL=https://markozy.com

# Contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=info@markozy.com
NEXT_PUBLIC_CONTACT_LOCATION=Jalan PJS 11/10, Bandar Sunway, 46150 Petaling Jaya, Selangor

# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=60177636862

# Social profiles (leave empty to show the icon as "coming soon")
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/markozydigital/
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/p/Markozy-61586802032191/
NEXT_PUBLIC_SOCIAL_TIKTOK=

# ---- Contact form delivery (server-side only) ----
# Option A: send inquiries by email through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend
CONTACT_FROM_EMAIL=Markozy Website <noreply@markozy.com>

# Option B: forward inquiries as JSON to a webhook (Zapier, Make, n8n, Slack workflow…)
CONTACT_WEBHOOK_URL=

# If neither option is configured, the form shows an honest "not connected yet"
# message instead of a fake success.
