# Copy this file to .env.local and fill in real values.

# Public site URL (used for metadata, sitemap and Open Graph links).
# Hosts starting with dev./staging./preview., localhost and *.vercel.app are automatically noindex.
NEXT_PUBLIC_SITE_URL=https://markozy.com
# Force noindex on any host (set to true on dev.markozy.com to be extra safe)
NEXT_PUBLIC_NOINDEX=

# Calendly / Cal.com booking link. When set, "Book a Free Consultation" opens it;
# when empty the button reads "Request a Free Consultation" and opens the contact form.
NEXT_PUBLIC_BOOKING_URL=

# SSM company registration number, shown in the footer and schema when set
NEXT_PUBLIC_COMPANY_REG_NO=

# Contact details shown on the site. LOCATION must be an address or city, not a phone number
# (a phone number here is ignored and falls back to "Petaling Jaya, Selangor, Malaysia").
NEXT_PUBLIC_CONTACT_EMAIL=info@markozy.com
NEXT_PUBLIC_CONTACT_LOCATION=Jalan PJS 11/10, Bandar Sunway, 46150 Petaling Jaya, Selangor

# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=60177636862

# Social profiles: full profile URLs only. Empty values or bare homepages (https://www.tiktok.com/) are hidden.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/markozydigital/
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/p/Markozy-61586802032191/
NEXT_PUBLIC_SOCIAL_TIKTOK=

# ---- Contact form delivery (server-side only) ----
# Option A: send inquiries by email through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend
CONTACT_FROM_EMAIL=Markozy Website <noreply@markozy.com>

# Option B: forward inquiries as JSON to a webhook (Zapier, Make, n8n, Slack workflow…)
CONTACT_WEBHOOK_URL=

# If neither option is configured, the form shows an honest "not connected yet"
# message instead of a fake success.
